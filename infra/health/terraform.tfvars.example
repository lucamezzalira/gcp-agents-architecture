project_id = "REPLACE_HEALTH_PROJECT"
region     = "europe-west1"
# github_owner = "lucamezzalira"
# github_repo  = "gcp-agents-architecture"
# services_ci_sa_email = "services-ci@REPLACE_SERVICES_PROJECT.iam.gserviceaccount.com"
# agent_engine_id is the numeric id of the existing Memory Bank engine in us-central1.
# Required for terraform plan/import against a project that already has one.
# agent_engine_id = "REPLACE_ENGINE_ID"
# memory_bank_location = "us-central1"
# After the first apply, optionally pin identity lookup to the runtime engine id
# (terraform output agent_runtime_id). Not the Memory Bank id.
# health_runtime_engine_id = "REPLACE_RUNTIME_ENGINE_ID"
# Cloud Run is the Pub/Sub receiver. agent_score_split must stay true (the live
# score/reason split). Doorway and combined-engine rollback were removed.
# agent_reasoner_image is required once agent_image is set.
# agent_reasoner_image = "europe-west1-docker.pkg.dev/PROJECT/health/reasoner:v1@sha256:DIGEST"
