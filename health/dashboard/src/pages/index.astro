---
import Layout from "../layouts/Layout.astro";
import { createPostgresStore } from "../lib/postgres";
import {
  buildDashboardModel,
  commitUrl,
  displayName,
  displayedCharacteristics,
  displayedOverall,
  hundredNote,
  improvementCopy,
  platformGapLine,
  platformRollupLine,
  platformSpreadLine,
  polyline,
  ringOffset,
  ruleSetMarkers,
  ruleSetVersionOf,
  scoreTone,
  shaTail,
  shortSha,
  toneColor,
  trendArea,
  trendCaption,
  trendHeading,
  trendPoints,
  trendScores,
} from "../lib/view";
import {
  ARCH_RULES,
  METRIC_SIGNALS,
  RULE_COUNT,
  scoringLine,
} from "../lib/rules";

const store = createPostgresStore();
const includeSuperseded = Astro.url.searchParams.get("history") === "all";
const runs = await store.loadRuns({ includeSuperseded });
const requested = Astro.url.searchParams.get("commit") ?? undefined;
const requestedRun = Astro.url.searchParams.get("run") ?? undefined;
const requestedService = Astro.url.searchParams.get("service") ?? undefined;
const model = buildDashboardModel(runs, requested, requestedRun, requestedService);
const selected = model.selected;
const selectedService = model.service;
const overall =
  selected === undefined ? 0 : displayedOverall(selected, selectedService);
const gapLine =
  selected === undefined ? "" : platformGapLine(selected, selectedService);
const characteristics =
  selected === undefined
    ? []
    : displayedCharacteristics(selected, selectedService);
const chartW = 640;
const chartH = 180;
const plotted = trendPoints(trendScores(model.runs, selectedService), chartW, chartH);
const versionMarks = ruleSetMarkers(model.runs, plotted);
const line = polyline(plotted);
const area = trendArea(plotted);
const radius = 58;
const circumference = 2 * Math.PI * radius;
const payload = JSON.stringify(model.runs);
const historyHref = includeSuperseded
  ? `?${new URLSearchParams({
      ...(requested ? { commit: requested } : {}),
      ...(requestedRun ? { run: requestedRun } : {}),
      ...(selectedService ? { service: selectedService } : {}),
    }).toString()}`
  : `?${new URLSearchParams({
      history: "all",
      ...(requested ? { commit: requested } : {}),
      ...(requestedRun ? { run: requestedRun } : {}),
      ...(selectedService ? { service: selectedService } : {}),
    }).toString()}`;
---

<Layout title="Architectural health">
  <main class="shell">
    <header class="top">
      <div class="brand">
        <span>Health system</span>
        <h1>Architecture score</h1>
      </div>
      {
        selected !== undefined && (
          <div class="top-actions">
            <button
              type="button"
              class:list={[
                "scope-chip",
                selectedService === undefined ? "is-selected" : "is-return",
              ]}
              data-service=""
              data-platform
              aria-pressed={selectedService === undefined}
            >
              <span>Overall</span>
              <strong data-platform-overall>{selected.overall}</strong>
            </button>
            <button type="button" class="scope-chip" data-rules-open>
              <span>Rules</span>
              <strong>{RULE_COUNT}</strong>
            </button>
          </div>
        )
      }
    </header>

    {
      selected === undefined ? (
        <p class="empty">
          No runs in Postgres yet. Start Postgres and run
          <code>./scripts/replay.sh</code>.
        </p>
      ) : (
        <section class="hero">
          <div class={`panel score-panel ${scoreTone(overall)}`} data-score-panel>
            <div class="ring-wrap">
              <svg viewBox="0 0 140 140" width="168" height="168" aria-hidden="true">
                <circle
                  cx="70"
                  cy="70"
                  r={radius}
                  fill="none"
                  stroke="rgba(255,255,255,0.08)"
                  stroke-width="8"
                />
                <circle
                  data-ring
                  cx="70"
                  cy="70"
                  r={radius}
                  fill="none"
                  stroke={toneColor(overall)}
                  stroke-width="8"
                  stroke-linecap="round"
                  stroke-dasharray={circumference}
                  stroke-dashoffset={ringOffset(overall, radius)}
                />
              </svg>
              <div data-overall class={`value ${scoreTone(overall)}`}>
                {overall}
              </div>
            </div>
            <p class="caption" data-scope-caption>
              {
                selectedService === undefined
                  ? "Platform overall · click a commit on the trend to compare"
                  : `${selectedService} overall · click Overall to return`
              }
            </p>
            <p
              class:list={["spread", selectedService === undefined ? "" : "is-hidden"]}
              data-platform-spread
            >
              {platformSpreadLine(selected)}
            </p>
            <p
              class:list={["gap", gapLine === "" ? "is-hidden" : ""]}
              data-platform-gap
            >
              {gapLine}
            </p>
            <p
              class:list={["rollup", selectedService === undefined ? "" : "is-hidden"]}
              data-platform-rollup
            >
              {platformRollupLine()}
            </p>
          </div>
          <div class="panel meta-panel">
            <div class="meta-grid">
              <div>
                <span>Commit</span>
                <a
                  class="sha"
                  data-commit
                  href={commitUrl(selected.commitSha)}
                  target="_blank"
                  rel="noopener noreferrer"
                >{shaTail(selected.commitSha)}</a>
              </div>
              <div>
                <span>Overall</span>
                <p data-overall-meta>{overall} / 100</p>
              </div>
              <div>
                <span>Message</span>
                <p data-message>{selected.commitMessage}</p>
              </div>
              <div>
                <span>Run</span>
                <p class="sha truncate" data-run-id title={selected.runId}>{selected.runId}</p>
              </div>
              <div>
                <span>Reasoner</span>
                <p data-reasoner>{selected.reasoner ?? "unknown"}</p>
              </div>
              <div>
                <span>Trace</span>
                <p
                  class="sha truncate"
                  data-trace-id
                  title={selected.traceId ?? "none"}
                >{selected.traceId ?? "none"}</p>
              </div>
              <div>
                <span>Rule set</span>
                <p data-rule-set>v{ruleSetVersionOf(selected)}</p>
              </div>
              <div>
                <span>State</span>
                <p data-state>{selected.state ?? "current"}</p>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      selected !== undefined && (
        <section class="panel map">
          <h2>Services</h2>
          <p class="signals">
            Checkout publishes send-instructions to notification and stock
            reservations to inventory. Inventory publishes reservation
            outcomes back. Notification is the only subscriber allowed to
            talk to the email provider.
          </p>
          <div class="service-map" data-service-map>
            <a
              class:list={[
                "svc",
                selectedService === undefined ? "is-selected" : "",
              ]}
              href={`?commit=${shortSha(selected.commitSha)}&run=${encodeURIComponent(selected.runId)}${includeSuperseded ? "&history=all" : ""}`}
              data-service=""
            >
              platform
              <strong data-platform-overall>{selected.overall}</strong>
            </a>
            <a
              class:list={[
                "svc",
                selectedService === "checkout" ? "is-selected" : "",
              ]}
              href={`?commit=${shortSha(selected.commitSha)}&run=${encodeURIComponent(selected.runId)}&service=checkout${includeSuperseded ? "&history=all" : ""}`}
              data-service="checkout"
            >
              checkout
              <strong data-checkout-overall>
                {selected.services.find((item) => item.service === "checkout")?.overall ?? "n/a"}
              </strong>
            </a>
            <span class="edge">reservations</span>
            <a
              class:list={[
                "svc",
                selectedService === "inventory" ? "is-selected" : "",
              ]}
              href={`?commit=${shortSha(selected.commitSha)}&run=${encodeURIComponent(selected.runId)}&service=inventory${includeSuperseded ? "&history=all" : ""}`}
              data-service="inventory"
            >
              inventory
              <strong data-inventory-overall>
                {selected.services.find((item) => item.service === "inventory")?.overall ?? "n/a"}
              </strong>
            </a>
            <span class="edge">send-instruction topic</span>
            <a
              class:list={[
                "svc",
                selectedService === "notification" ? "is-selected" : "",
              ]}
              href={`?commit=${shortSha(selected.commitSha)}&run=${encodeURIComponent(selected.runId)}&service=notification${includeSuperseded ? "&history=all" : ""}`}
              data-service="notification"
            >
              notification
              <strong data-notification-overall>
                {selected.services.find((item) => item.service === "notification")?.overall ?? "n/a"}
              </strong>
            </a>
          </div>
        </section>
      )
    }

    {
      selected !== undefined && (
        <section class="cards" data-cards aria-label="Characteristics">
          {characteristics.map((item) => {
            const recs = improvementCopy(item.score, item.recommendations);
            const note = hundredNote(item);
            return (
              <article
                class:list={[
                  "panel",
                  "card",
                  note !== undefined && (item.suppressedBy ?? []).length > 0
                    ? "card-suppressed"
                    : "",
                ]}
              >
                <header>
                  <h2>{displayName(item.id)}</h2>
                  <div class={`n ${scoreTone(item.score)}`}>{item.score}</div>
                </header>
                <div class={`meter ${scoreTone(item.score)}`}>
                  <span style={`width: ${item.score}%`} />
                </div>
                <p>{item.reasoning}</p>
                {note !== undefined ? (
                  <p class={ (item.suppressedBy ?? []).length > 0 ? "suppressed-note" : "ok-note"}>
                    {note}
                  </p>
                ) : (
                  <div class="improve">
                    <h3>How to improve</h3>
                    <ul>
                      {recs.map((rec) => (
                        <li>{rec}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {item.signalsUsed.length > 0 && (
                  <p class="signals">{item.signalsUsed.join(" · ")}</p>
                )}
              </article>
            );
          })}
        </section>
      )
    }

    <section class="panel trend">
      <h2 data-trend-heading>{trendHeading(selectedService)}</h2>
      {
        model.runs.length === 0 ? (
          <p>No history yet.</p>
        ) : (
          <>
            <p class="signals" data-trend-caption>
              {trendCaption(selectedService)}
            </p>
            <p class="history-toggle">
              <a href={historyHref}>
                {includeSuperseded
                  ? "Hide superseded runs"
                  : "Show superseded runs"}
              </a>
            </p>
            <svg class="chart" viewBox={`0 0 ${chartW} ${chartH}`} role="img">
              <title data-trend-title>
                {
                  selectedService === undefined
                    ? "Platform overall across commits. Click a point to inspect that run."
                    : `${selectedService} overall across commits. Click a point to inspect that run.`
                }
              </title>
              <defs>
                <linearGradient id="trendFill" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#4ade80" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#4ade80" stop-opacity="0" />
                </linearGradient>
              </defs>
              <line class="grid" x1="12" y1="36" x2="628" y2="36" />
              <line class="grid" x1="12" y1="90" x2="628" y2="90" />
              <line class="grid" x1="12" y1="144" x2="628" y2="144" />
              {
                versionMarks.map((mark) => (
                  <g class="version-mark">
                    <line x1={mark.x} y1="12" x2={mark.x} y2="168" />
                    <text x={mark.x + 6} y="22">
                      v{mark.version}
                    </text>
                  </g>
                ))
              }
              <polygon class="area" data-trend-area points={area} />
              <polyline class="line" data-trend-line points={line} />
              {plotted.map((point, index) => {
                const run = model.runs[index];
                if (run === undefined) {
                  return null;
                }
                const selectedDot = run.runId === selected?.runId;
                return (
                  <g
                    data-run={run.runId}
                    class={selectedDot ? "is-selected" : ""}
                    role="button"
                    tabindex="0"
                    aria-label={`Inspect ${shortSha(run.commitSha)}, ${selectedService ?? "platform"} ${point.score}`}
                    aria-pressed={selectedDot ? "true" : "false"}
                  >
                    <circle class="hit" cx={point.x} cy={point.y} r="18" />
                    <circle
                      class={`dot ${scoreTone(point.score)}`}
                      cx={point.x}
                      cy={point.y}
                      r="5"
                    />
                  </g>
                );
              })}
            </svg>
            <div class="legend">
              {model.runs.map((run) => {
                const score = displayedOverall(run, selectedService);
                return (
                <button
                  type="button"
                  data-run={run.runId}
                  class:list={[
                    `${scoreTone(score)}-label`,
                    run.runId === selected?.runId ? "is-selected" : "",
                  ]}
                  aria-pressed={run.runId === selected?.runId}
                >
                  <div class="sha" data-legend-score>
                    {shortSha(run.commitSha)} · {score}
                    {run.state === "superseded" ? " · superseded" : ""}
                    {` · v${ruleSetVersionOf(run)}`}
                  </div>
                  <p>{run.commitMessage}</p>
                </button>
                );
              })}
            </div>
          </>
        )
      }
    </section>
  </main>

  <dialog class="rules-modal" data-rules-modal aria-labelledby="rules-modal-title">
    <div class="rules-modal-inner">
      <header>
        <h2 id="rules-modal-title">Architecture rules</h2>
        <button type="button" class="rules-close" data-rules-close>
          Close
        </button>
      </header>
      <p class="rules-lead">
        Each characteristic starts at 100. A finding subtracts its penalty,
        floored at 0. The service that committed the import takes the hit.
        Rules 3, 4, 5 and 7 also move platform cross-service-integrity, which
        is the platform's boundary channel. Platform boundary-integrity is a
        mean across services.
      </p>
      <ol class="rule-list">
        {ARCH_RULES.map((rule) => (
          <li>
            <div class="rule-head">
              <span class="rule-id">{rule.id}</span>
              <strong>{rule.title}</strong>
            </div>
            <p>{rule.description}</p>
            <p class="rule-score">{scoringLine(rule)}</p>
          </li>
        ))}
      </ol>
      <h3>Other signals</h3>
      <ul class="metric-list">
        {METRIC_SIGNALS.map((item) => (
          <li>
            <strong>{item.description}.</strong>
            {" "}
            Scores on {item.characteristic}. Penalty {item.penalty}.
          </li>
        ))}
      </ul>
    </div>
  </dialog>

  <script id="runs-data" type="application/json" set:html={payload} />
  <script>
    import { mountBoard } from "../lib/board";
    import type { HealthRun } from "../lib/types";

    const node = document.getElementById("runs-data");
    if (node?.textContent) {
      const runs = JSON.parse(node.textContent) as HealthRun[];
      mountBoard(runs);
    }
  </script>
</Layout>
